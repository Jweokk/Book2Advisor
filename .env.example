# Book2Advisor — 环境变量模板
# 复制为 .env 并填入真实值。禁止将真实 .env 提交到 git。

# LLM API Key（必填，OpenAI 兼容接口）
# 默认使用 DeepSeek：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-key-here

# 方法模型路径（必填，绝对或相对路径；指向编译好的方法模型 yaml）
# METHOD_MODEL=/path/to/data/methods/<person>/<model>.yaml

# 可选：换用任意 OpenAI 兼容端点（不设置则用 DeepSeek 默认值）
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-v4-flash
