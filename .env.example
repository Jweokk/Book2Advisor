# Book2Advisor — 环境变量模板
# 复制为 .env 并填入真实值。禁止将真实 .env 提交到 git。

# Web 登录密码（必填）
ADVISOR_PASSWORD=your_password_here

# DeepSeek API Key（必填，OpenAI 兼容接口；也支持任意 OpenAI 兼容服务）
# 获取：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-key-here

# 方法模型路径（可选，容器内绝对路径；不填则使用默认示例模型）
# METHOD_MODEL=/app/data/methods/<person>/<model>.yaml
